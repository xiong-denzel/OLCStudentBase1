   "source": [
    "#Task 3.1\n",
    "def count_vowel(x):\n",
    "    x = x.lower()\n",
    "    vowels = 0\n",
    "    vowel = \"aeiou\"\n",
    "    for i in range(len(x)):\n",
    "        if x[i] in vowel:\n",
    "            vowels += len(x[i])\n",
    "    return vowels\n",
    "            \n",
    "            "
   ]
